# Copy to brain/.env (git-ignored) and fill in. Never commit real keys.

# Cartesia: speech to text (ink-whisper) and Famyy's voice (sonic). Without it the brain is text only.
CARTESIA_API_KEY=

# Claude runs through Claude Code. "login" uses Claude Code's own login (Fo comes through claude.ai);
# "key" uses ANTHROPIC_API_KEY (then sign Fo in once with /mcp > fo in an interactive `claude`).
FEMI_AUTH=login
ANTHROPIC_API_KEY=
# Only for a key that isn't scoped to one workspace:
ANTHROPIC_WORKSPACE_ID=

# Optional (defaults in brackets):
# FEMI_MODEL=claude-haiku-5-5     FEMI_EFFORT=low       FEMI_EMOTION=content
# FEMI_CAMERA=/dev/video0 (none)  FEMI_ACK_MINUTES=10   FEMI_PORT=8787  FEMI_TOOLS_PORT=8788
# FAMILY_DIR=<repo>/family        (profile.json, photos/, reminders.json: all git-ignored)
